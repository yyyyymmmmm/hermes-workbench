HOST=127.0.0.1
PORT=4317
PUBLIC_ORIGIN=http://127.0.0.1:4317
AUTH_BASE_URL=https://api.didichou.site/api.php
AUTH_APP_ID=10016
AUTH_APP_SECRET=
AUTH_ENCODING=plain
AUTH_RESPONSE_CLOCK_TOLERANCE_SECONDS=300
SESSION_TTL_SECONDS=28800
DATA_DIR=.runtime
# Production: HTTPS origin, SECURE_COOKIES=true, separate reverse proxy.
SECURE_COOKIES=false
# Comma-separated exact hostnames allowed to resolve to private/LAN addresses.
# Empty by default. Cloud metadata and unspecified addresses are never allowed.
HERMES_PRIVATE_HOSTS=

